      "level": "REQ LEV",
      "req": "其他需求屬性 { str, dex, int, luk } (可選)",
      "classes": "限制職業大類 ['warrior','magician','bowman','thief','pirate'] (可選)",
      "maxStars": "最大星力 (0 代表不可強化)",
      "attackSpeed": "攻擊速度 (僅武器,1~10 數字)",
      "stats": "基礎屬性加成;支援 str/dex/int/luk/hp/mp/atk/matk/def/bossDmg/ignoreDef/allStatPct 等,% 類以 bossDmg / ignoreDef / *Pct 判定",
      "description": "敘述 (可選)",
      "imageUrl": "裝備圖片 URL (可選)"
    }
  },
