  "$schema": {
    "description": "裝備基礎資料 — 僅存「基礎數值」;使用者在背包中新增/強化 (星力 / Bonus Stats / 潛能 / 附加潛能) 屬於 entry 實例狀態,不寫回此表",
    "fields": {
      "id": "唯一 ID",
      "apiItemId": "MSU Open API 的數字 item ID (用於 API 查詢與套裝比對)",
